{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "one-time-password",
  "title": "One Time Password",
  "description": "Generate time-based one-time passwords",
  "icon": "assets/icon.png",
  "author": "almatkai",
  "contributors": [
    "soulevans07",
    "BalliAsghar",
    "midskyey",
    "ernest0n"
  ],
  "categories": [
    "Security",
    "Productivity"
  ],
  "keywords": [
    "authentication",
    "security",
    "verification",
    "code",
    "token",
    "login",
    "two-factor authentication",
    "OTP"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "one-time-password",
      "title": "One Time Password",
      "subtitle": "Generate time-based one-time passwords",
      "description": "Generate time-based one-time passwords",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "paste-recent-otp",
      "title": "Paste Recent OTP",
      "subtitle": "One Time Password",
      "description": "Paste the OTP code from the most recently used account into the active app",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "passwordVisibility",
      "description": "Display the generated password in the Raycast window for preview",
      "label": "Toggle password visibility",
      "type": "checkbox",
      "required": true,
      "default": true
    },
    {
      "name": "primaryAction",
      "description": "The primary action to perform on an item.",
      "title": "Primary Action",
      "type": "dropdown",
      "required": false,
      "default": "copy",
      "data": [
        {
          "title": "Copy to Clipboard",
          "value": "copy"
        },
        {
          "title": "Paste to Active App",
          "value": "paste"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.2.0",
    "hi-base32": "^0.5.1",
    "jimp": "^0.22.7",
    "jsqr": "^1.4.0",
    "otpauth": "^9.1.1",
    "protobufjs": "^7.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "tsx": "^4.22.4"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.one-time-password",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/one-time-password",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/one-time-password",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
